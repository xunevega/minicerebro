# Editados V1.
# En local puedes dejar AUTH_REQUIRED=false.
# En Railway el Dockerfile fuerza produccion: cuenta, sin /docs y sin CORS localhost.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ENV=local
AUTH_REQUIRED=false
SESSION_SECRET=dev-insecure-editados-session
ADMIN_EMAIL=
ENABLE_DOCS=true
CORS_ALLOW_LOCALHOST=true
